complete -c kakikomi -n __fish_use_subcommand -a format -d 'quick format a disk'
complete -c kakikomi -n __fish_use_subcommand -a doctor -d 'check the tools kakikomi needs'
complete -c kakikomi -n __fish_use_subcommand -a version -d 'print the version'
complete -c kakikomi -n __fish_use_subcommand -a help -d 'print usage'
complete -c kakikomi -n '__fish_seen_subcommand_from format' -a 'fat32 exfat fat floppy' -d 'filesystem'

complete -c kakikomi -l verify -d 'compare the whole disk with the image at the end'
complete -c kakikomi -l no-verify -d 'skip the whole-disk comparison'
complete -c kakikomi -l delete -d 'move the image to the Trash once every disk validated'
complete -c kakikomi -l no-delete -d 'keep the image'
complete -c kakikomi -l again -d 'write the same image to the next disk you insert'
complete -c kakikomi -l reinsert -d 'check the disk again after it is plugged back in'
complete -c kakikomi -l no-reinsert -d 'skip the reinsertion check'
complete -c kakikomi -l zero-tail -d 'blank the space past the image'
complete -c kakikomi -l sha256 -x -d 'stop unless the image matches this SHA-256'
complete -c kakikomi -l allow-internal -d 'allow an internal disk'
complete -c kakikomi -l keep-guard -d 'keep macOS from ever mounting the disk again'
complete -c kakikomi -l raw -d 'write a Windows ISO as is'
complete -c kakikomi -l release -d 'remove mount guards a run left behind'
