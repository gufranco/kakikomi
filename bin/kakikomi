#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh

for disk_inherited in $(env | sed -n 's/^\(DISK_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "${disk_inherited}"
done

disk_self="$0"
case "${disk_self}" in
*/*) ;;
*) disk_self="$(command -v -- "${disk_self}")" ;;
esac
DISK_LIB="$(cd "${disk_self%/*}/../lib" && pwd)" || exit 1

DISK_PROG=kakikomi
# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${DISK_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/cli.sh
. "${DISK_LIB}/cli.sh"
# shellcheck source=SCRIPTDIR/../lib/io.sh
. "${DISK_LIB}/io.sh"
# shellcheck source=SCRIPTDIR/../lib/calibrate.sh
. "${DISK_LIB}/calibrate.sh"
# shellcheck source=SCRIPTDIR/../lib/wipe.sh
. "${DISK_LIB}/wipe.sh"
# shellcheck source=SCRIPTDIR/../lib/source.sh
. "${DISK_LIB}/source.sh"
# shellcheck source=SCRIPTDIR/../lib/checksum.sh
. "${DISK_LIB}/checksum.sh"
# shellcheck source=SCRIPTDIR/../lib/guard.sh
. "${DISK_LIB}/guard.sh"
# shellcheck source=SCRIPTDIR/../lib/ui.sh
. "${DISK_LIB}/ui.sh"
# shellcheck source=SCRIPTDIR/../lib/write.sh
. "${DISK_LIB}/write.sh"
# shellcheck source=SCRIPTDIR/../lib/after.sh
. "${DISK_LIB}/after.sh"
# shellcheck source=SCRIPTDIR/../lib/boot.sh
. "${DISK_LIB}/boot.sh"
# shellcheck source=SCRIPTDIR/../lib/flow.sh
. "${DISK_LIB}/flow.sh"
# shellcheck source=SCRIPTDIR/../lib/format.sh
. "${DISK_LIB}/format.sh"

disk_write_usage() {
  cat <<'USAGE'
kakikomi - write disk images to removable media, verified, never mounted

usage:
  kakikomi                     ask what to do, step by step
  kakikomi [options] <image|url|device> [target...]
                               write an image to one or more disks
  kakikomi format [options] [target] [fat32|exfat|fat|floppy] [label]
                               quick format a disk
  kakikomi release             remove mount guards a run left behind
  kakikomi doctor              check the tools kakikomi needs
  kakikomi version             print the version
  kakikomi help                print this page

options:
  --verify | --no-verify       read the whole disk back and compare its SHA-256
                               at the end (default yes)
  --delete | --no-delete       move the image to the Trash once every disk
                               validated (default no)
  --again                      write the same image to the next disk you insert
  --reinsert | --no-reinsert   after ejecting, wait for the disk to return and
                               compare again (default no)
  --zero-tail                  blank the space past the image on a larger disk
  --sha256 HASH                stop unless the image matches this SHA-256.
                               without it, a checksum file published next to
                               the image is read
  --allow-internal             allow an internal disk. the system disk is always
                               refused
  --keep-guard                 keep macOS from ever mounting that disk again
  --raw                        write a Windows ISO as is instead of as a FAT32
                               installer

environment:
  KAKIKOMI_VERIFY, KAKIKOMI_DELETE, KAKIKOMI_AGAIN, KAKIKOMI_REINSERT,
  KAKIKOMI_ZERO_TAIL, KAKIKOMI_SHA256, KAKIKOMI_ALLOW_INTERNAL,
  KAKIKOMI_KEEP_GUARD and KAKIKOMI_MODE=raw set the same options, with y or n
  for yes or no. an option on the command line wins.

notes:
  A disk is named by its device, such as /dev/disk4, or by any volume mounted
  from it, such as /Volumes/USB, which stands for the whole disk. Leave the
  target out to pick from the attached removable disks. The target is never
  mounted, not even for a moment. A file named help, doctor, version or format
  is written by giving its path, such as ./help.

  A checksum file next to the image, such as debian.iso.sha256, SHA256SUMS,
  MD5SUMS, b2sums.txt, a Fedora CHECKSUM or an .sfv, is read when it names the
  image, in any of the usual formats and algorithms. A mismatch stops the run
  before any disk is touched. For a URL, the same names are asked of its
  server.

examples:
  kakikomi debian.img.xz /dev/disk4
  kakikomi debian.img.xz /Volumes/USB
  kakikomi https://example.org/os.img.gz
  kakikomi debian.img.xz /dev/disk4 /dev/disk5
  kakikomi /dev/disk4 /dev/disk5
  kakikomi /Volumes/OLD /Volumes/NEW
  kakikomi --again game.ima
  kakikomi format /dev/disk4 exfat MEDIA
USAGE
}

disk_option_flag() {
  case "$1" in
  --verify) KAKIKOMI_VERIFY=y ;;
  --no-verify) KAKIKOMI_VERIFY=n ;;
  --delete) KAKIKOMI_DELETE=y ;;
  --no-delete) KAKIKOMI_DELETE=n ;;
  --again) KAKIKOMI_AGAIN=y ;;
  --reinsert) KAKIKOMI_REINSERT=y ;;
  --no-reinsert) KAKIKOMI_REINSERT=n ;;
  --zero-tail) KAKIKOMI_ZERO_TAIL=y ;;
  --allow-internal) KAKIKOMI_ALLOW_INTERNAL=y ;;
  --keep-guard) KAKIKOMI_KEEP_GUARD=y ;;
  --raw) KAKIKOMI_MODE=raw ;;
  *) return 1 ;;
  esac
  export KAKIKOMI_VERIFY KAKIKOMI_DELETE KAKIKOMI_AGAIN KAKIKOMI_REINSERT KAKIKOMI_ZERO_TAIL
  export KAKIKOMI_ALLOW_INTERNAL KAKIKOMI_KEEP_GUARD KAKIKOMI_MODE
  return 0
}

disk_option_value() {
  KAKIKOMI_SHA256="$2"
  export KAKIKOMI_SHA256
  return 0
}

disk_parse() {
  DISK_VALUE_OPTIONS="--sha256"
  disk_pa_left="$#"
  disk_pa_literal=0
  while [ "${disk_pa_left}" -gt 0 ]; do
    disk_pa_arg="$1"
    shift
    disk_pa_left=$((disk_pa_left - 1))
    if [ "${disk_pa_literal}" -eq 1 ] || ! disk_cli_is_option "${disk_pa_arg}"; then
      set -- "$@" "${disk_pa_arg}"
    elif [ "${disk_pa_arg}" = "--" ]; then
      disk_pa_literal=1
    else
      disk_cli_option "${disk_pa_arg}" "${disk_pa_left}" "${1:-}" || return 1
      if [ "${DISK_CLI_USED}" -eq 1 ]; then
        shift
        disk_pa_left=$((disk_pa_left - 1))
      fi
    fi
  done
  "${DISK_PARSED}" "$@"
}

disk_write_menu() {
  printf '%s\n' "What would you like to do?" "  1) write an image to a disk" "  2) quick format a disk" "  3) check this machine" >&2
  disk_wn_choice="$(disk_prompt "Choice" 1)" || return 1
  case "${disk_wn_choice}" in
  1) disk_write_ask_image ;;
  2) disk_format_main ;;
  3) disk_doctor ;;
  *)
    disk_cli_hint "unknown choice '${disk_wn_choice}'"
    return 1
    ;;
  esac
}

disk_write_ask_image() {
  disk_wa_image="$(disk_ask_required "Image file, URL or source disk" "no image given")" || return 1
  disk_write_start "${disk_wa_image}"
}

disk_write_windows_mode() {
  disk_is_windows_iso "${DISK_SRC_PATH}" || return 0
  disk_info "This is a Windows installer ISO. Written as is it would not boot from USB,"
  disk_info "so it is laid out as a UEFI-bootable FAT32 drive instead. --raw writes it unchanged."
  disk_ww_image="$(disk_windows_image "${DISK_SRC_PATH}")" || return 1
  DISK_SRC_PATH="${disk_ww_image}"
  DISK_SRC_SIZE="$(disk_file_size "${disk_ww_image}")"
  DISK_SRC_NOTE="Windows installer laid out as FAT32"
  return 0
}

disk_write_start() {
  disk_wm_source="$1"
  shift
  DISK_SRC_WORK="$(mktemp -d "${TMPDIR:-/tmp}/disk_write_src.XXXXXX")" || return 1
  trap disk_write_cleanup EXIT
  trap disk_write_interrupted INT TERM HUP
  disk_source_open "${disk_wm_source}" || return 1
  disk_write_published || return 1
  disk_write_windows_mode || return 1
  disk_write_checksum || return 1
  disk_wm_status=0
  disk_write_once "$@" || disk_wm_status=1
  disk_after_write "${disk_wm_status}"
}

disk_write_main() {
  case "${1:-}" in
  format)
    shift
    disk_format_main "$@"
    ;;
  release)
    DISK_TMPDIR="${TMPDIR:-/tmp}"
    disk_fstab_release_all
    ;;
  help | -h | --help) disk_write_usage ;;
  version | -V | --version) disk_cli_version ;;
  doctor) disk_doctor ;;
  *)
    DISK_PARSED=disk_write_entry
    disk_parse "$@"
    ;;
  esac
}

disk_write_entry() {
  if [ "$#" -gt 0 ]; then
    disk_write_start "$@"
    return "$?"
  fi
  if disk_cli_interactive; then
    disk_write_menu
    return "$?"
  fi
  disk_cli_hint "no image given"
  return 1
}

disk_write_main "$@"
